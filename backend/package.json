{
  "name": "matchai-backend-integracoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "check:email": "tsx scripts/check-email.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "nodemailer": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
