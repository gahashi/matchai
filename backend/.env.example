# Porta HTTP para health check local. Ainda não expõe rotas públicas de upload.
PORT=3103
HOST=127.0.0.1

# S3 compatível com RustFS. Chaves serão geradas por scripts/setup-local.sh.
S3_ENDPOINT=http://127.0.0.1:9020
S3_REGION=us-east-1
S3_BUCKET=matchai-dev
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# SMTP (copiar seus valores locais reais sem compartilhar as credenciais)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=MatchAI
EMAIL_FROM_ADDRESS=
