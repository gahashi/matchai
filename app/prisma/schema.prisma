generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =========================================================
// SYS — USUÁRIOS / AUTENTICAÇÃO
// =========================================================

model SysUsuarioTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(50)
  nome       String    @db.VarChar(100)
  descricao  String?   @db.VarChar(255)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_usuarios SysUsuario[]

  @@map("sys_usuario_tipo")
}

model SysUsuario {
  id                    Int     @id @default(autoincrement())
  sys_usuario_tipo_id   Int
  nome                  String  @db.VarChar(150)
  nickname              String  @unique @db.VarChar(50)
  email                 String  @unique @db.VarChar(150)
  telefone              String? @db.VarChar(30)
  documento             String? @db.VarChar(30)
  avatar_sys_arquivo_id Int?
  ativo                 Int     @default(1)

  perfil_completo     Int       @default(0)
  email_verificado_at DateTime? @db.DateTime(0)
  ultimo_login_at     DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  sys_usuario_tipo SysUsuarioTipo @relation(fields: [sys_usuario_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  avatar_sys_arquivo SysArquivo? @relation("SysUsuarioAvatar", fields: [avatar_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  sys_analytics_eventos        SysAnalyticsEvento[]
  sys_auth_user                User?
  sys_auth_login_logs          SysAuthLoginLog[]
  sys_email_logs               SysEmailLog[]
  sys_email_verification_codes SysEmailVerificationCode[]

  sys_arquivos_criados SysArquivo[] @relation("SysArquivoCriadoPor")

  vnd_pedidos VndPedido[]

  soc_socios            SocSocio[]
  par_parceiro_usuarios ParParceiroUsuario[]

  vnd_pedido_historicos_operados VndPedidoHistorico[]

  @@index([sys_usuario_tipo_id])
  @@index([ativo])
  @@index([deleted_at])
  @@map("sys_usuario")
}

// =========================================================
// BETTER AUTH
//
// Mantemos os nomes esperados pelo Better Auth.
// As tabelas físicas continuam prefixadas com sys_auth_.
// =========================================================

model User {
  id            String   @id @db.VarChar(191)
  name          String   @db.VarChar(150)
  email         String   @unique @db.VarChar(150)
  emailVerified Boolean  @default(false)
  image         String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @updatedAt @db.DateTime(0)

  sysUsuarioId Int        @unique @map("sys_usuario_id")
  sys_usuario  SysUsuario @relation(fields: [sysUsuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sessions Session[]
  accounts Account[]

  @@index([sysUsuarioId], map: "sys_auth_user_fk1")
  @@map("sys_auth_user")
}

model Session {
  id        String   @id @db.VarChar(191)
  expiresAt DateTime @db.DateTime(0)
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  userId String @map("user_id") @db.VarChar(191)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "sys_auth_session_fk1")
  @@map("sys_auth_session")
}

model Account {
  id         String @id @db.VarChar(191)
  accountId  String @map("account_id") @db.VarChar(191)
  providerId String @map("provider_id") @db.VarChar(191)
  userId     String @map("user_id") @db.VarChar(191)

  accessToken  String? @map("access_token") @db.Text
  refreshToken String? @map("refresh_token") @db.Text
  idToken      String? @map("id_token") @db.Text

  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.DateTime(0)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.DateTime(0)

  scope    String? @db.Text
  password String? @db.Text

  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "sys_auth_account_fk1")
  @@map("sys_auth_account")
}

model Verification {
  id         String    @id @db.VarChar(191)
  identifier String    @db.VarChar(191)
  value      String    @db.Text
  expiresAt  DateTime  @db.DateTime(0)
  createdAt  DateTime? @default(now()) @db.DateTime(0)
  updatedAt  DateTime? @updatedAt @db.DateTime(0)

  @@index([identifier])
  @@map("sys_auth_verification")
}

model SysAuthLoginLog {
  id             Int  @id @default(autoincrement())
  sys_usuario_id Int?

  email  String? @db.VarChar(150)
  evento String  @db.VarChar(80)
  status String  @db.VarChar(50)

  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  device_text   String? @db.VarChar(255)
  location_text String? @db.VarChar(255)

  error_message String? @db.Text
  metadata_text String? @db.Text

  created_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([sys_usuario_id])
  @@index([email])
  @@index([evento])
  @@index([status])
  @@index([created_at])
  @@map("sys_auth_login_log")
}

// =========================================================
// SYS — E-MAIL
// =========================================================

model SysEmailLog {
  id             Int  @id @default(autoincrement())
  sys_usuario_id Int?

  email_to   String @db.VarChar(180)
  email_from String @db.VarChar(180)
  subject    String @db.VarChar(255)

  template String? @db.VarChar(100)

  provider String @default("smtp") @db.VarChar(50)
  status   String @default("sent") @db.VarChar(50)

  message_id    String? @db.VarChar(255)
  error_message String? @db.Text
  metadata_text String? @db.Text

  sent_at    DateTime? @db.DateTime(0)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([sys_usuario_id])
  @@index([email_to])
  @@index([status])
  @@index([created_at])
  @@map("sys_email_log")
}

model SysEmailVerificationCode {
  id             Int  @id @default(autoincrement())
  sys_usuario_id Int?

  email String @db.VarChar(180)

  tipo String @default("email_verification") @db.VarChar(80)

  codigo_hash String @db.VarChar(255)

  tentativas     Int @default(0)
  max_tentativas Int @default(5)

  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([sys_usuario_id])
  @@index([email])
  @@index([tipo])
  @@index([expires_at])
  @@map("sys_email_verification_code")
}

// =========================================================
// SYS — ARQUIVOS / MINIO
// =========================================================

model SysArquivoDisco {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(40)
  nome       String    @db.VarChar(80)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_arquivos SysArquivo[]

  @@map("sys_arquivo_disco")
}

model SysArquivoVisibilidade {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(40)
  nome       String    @db.VarChar(80)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_arquivos SysArquivo[]

  @@map("sys_arquivo_visibilidade")
}

model SysArquivoTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(60)
  nome       String    @db.VarChar(120)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_arquivos SysArquivo[]

  @@map("sys_arquivo_tipo")
}

model SysArquivo {
  id                          Int  @id @default(autoincrement())
  sys_arquivo_disco_id        Int
  sys_arquivo_visibilidade_id Int
  sys_arquivo_tipo_id         Int?

  bucket        String? @db.VarChar(120)
  file_key      String  @db.VarChar(500)
  public_url    String? @db.VarChar(1000)
  original_name String  @db.VarChar(255)
  mime_type     String  @db.VarChar(120)
  size_bytes    Int
  content_hash  String? @db.VarChar(128)

  created_by_sys_usuario_id Int?

  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)
  storage_deleted_at DateTime? @db.DateTime(0)

  sys_arquivo_disco SysArquivoDisco @relation(fields: [sys_arquivo_disco_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sys_arquivo_visibilidade SysArquivoVisibilidade @relation(fields: [sys_arquivo_visibilidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sys_arquivo_tipo SysArquivoTipo? @relation(fields: [sys_arquivo_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  created_by_sys_usuario SysUsuario? @relation("SysArquivoCriadoPor", fields: [created_by_sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  sys_usuarios_avatar SysUsuario[] @relation("SysUsuarioAvatar")

  prd_produto_imagens PrdProdutoImagem[]

  cad_eventos_banner CadEvento[] @relation("CadEventoBanner")

  soc_planos_banner    SocPlano[]        @relation("SocPlanoBanner")
  par_parceiros_logo   ParParceiroTema[] @relation("ParParceiroTemaLogo")
  par_parceiros_banner ParParceiroTema[] @relation("ParParceiroTemaBanner")
  crd_itens_imagem     CrdItem[]         @relation("CrdItemImagem")
  crd_promocoes_imagem CrdPromocao[]     @relation("CrdPromocaoImagem")
  tv_exibicoes_midia   TvExibicao[]      @relation("TvExibicaoMidia")

  @@index([sys_arquivo_disco_id])
  @@index([sys_arquivo_visibilidade_id])
  @@index([sys_arquivo_tipo_id])
  @@index([file_key])
  @@index([content_hash])
  @@index([created_by_sys_usuario_id])
  @@index([deleted_at])
  @@map("sys_arquivo")
}

// =========================================================
// CAD — LINKS PÚBLICOS
// =========================================================

model CadLink {
  id Int @id @default(autoincrement())

  titulo    String  @db.VarChar(120)
  descricao String? @db.VarChar(255)

  url  String  @db.VarChar(1000)
  icon String? @db.VarChar(100)

  ordem    Int @default(0)
  destaque Int @default(0)
  ativo    Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@index([ativo, ordem])
  @@index([deleted_at])
  @@map("cad_link")
}

// =========================================================
// CAD — EVENTOS / LINKS TEMPORÁRIOS
// =========================================================

model CadEvento {
  id Int @id @default(autoincrement())

  titulo    String  @db.VarChar(150)
  descricao String? @db.Text
  url       String? @db.VarChar(1000)

  banner_sys_arquivo_id Int?
  par_parceiro_id       Int?

  evento_at DateTime? @db.DateTime(0)

  inicio_exibicao DateTime? @db.DateTime(0)
  fim_exibicao    DateTime? @db.DateTime(0)

  ordem           Int @default(0)
  destaque        Int @default(0)
  ativo           Int @default(1)
  visivel_publico Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  banner_sys_arquivo SysArquivo? @relation("CadEventoBanner", fields: [banner_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  par_parceiro ParParceiro? @relation(fields: [par_parceiro_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  tv_exibicao TvExibicao?

  @@index([par_parceiro_id])
  @@index([par_parceiro_id, ativo])
  @@index([ativo])
  @@index([ativo, visivel_publico])
  @@index([inicio_exibicao, fim_exibicao])
  @@index([evento_at])
  @@index([banner_sys_arquivo_id])
  @@index([deleted_at])
  @@map("cad_evento")
}

// =========================================================
// PAR — PARCEIROS
// =========================================================

model ParParceiro {
  id Int @id @default(autoincrement())

  codigo String @unique @db.VarChar(60)
  slug   String @unique @db.VarChar(150)

  nome      String  @db.VarChar(150)
  descricao String? @db.Text

  email_contato String? @db.VarChar(190)
  telefone      String? @db.VarChar(30)
  whatsapp      String? @db.VarChar(30)

  endereco        String? @db.VarChar(500)
  google_maps_url String? @db.VarChar(1000)

  instagram_url String? @db.VarChar(1000)
  site_url      String? @db.VarChar(1000)

  horario_funcionamento String? @db.Text

  ativo           Int @default(1)
  visivel_publico Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  par_parceiro_usuarios ParParceiroUsuario[]
  par_parceiro_tema     ParParceiroTema?
  crd_categorias        CrdCategoria[]
  crd_itens             CrdItem[]
  crd_promocoes         CrdPromocao[]
  cad_eventos           CadEvento[]
  tv_exibicoes          TvExibicao[]

  @@index([ativo])
  @@index([ativo, visivel_publico])
  @@index([deleted_at])
  @@map("par_parceiro")
}

model ParParceiroUsuarioTipo {
  id Int @id @default(autoincrement())

  codigo    String  @unique @db.VarChar(50)
  nome      String  @db.VarChar(100)
  descricao String? @db.VarChar(255)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  par_parceiro_usuarios ParParceiroUsuario[]

  @@index([ativo])
  @@map("par_parceiro_usuario_tipo")
}

model ParParceiroUsuario {
  id Int @id @default(autoincrement())

  par_parceiro_id              Int
  sys_usuario_id               Int
  par_parceiro_usuario_tipo_id Int

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  par_parceiro ParParceiro @relation(fields: [par_parceiro_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sys_usuario SysUsuario @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  par_parceiro_usuario_tipo ParParceiroUsuarioTipo @relation(fields: [par_parceiro_usuario_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([par_parceiro_id, sys_usuario_id])
  @@index([par_parceiro_id, ativo])
  @@index([sys_usuario_id, ativo])
  @@index([par_parceiro_usuario_tipo_id])
  @@map("par_parceiro_usuario")
}

model ParParceiroTema {
  id Int @id @default(autoincrement())

  par_parceiro_id Int @unique

  logo_sys_arquivo_id   Int?
  banner_sys_arquivo_id Int?

  cor_primaria   String? @db.VarChar(20)
  cor_secundaria String? @db.VarChar(20)
  cor_fundo      String? @db.VarChar(20)
  cor_texto      String? @db.VarChar(20)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  par_parceiro ParParceiro @relation(fields: [par_parceiro_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  logo_sys_arquivo SysArquivo? @relation("ParParceiroTemaLogo", fields: [logo_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  banner_sys_arquivo SysArquivo? @relation("ParParceiroTemaBanner", fields: [banner_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([logo_sys_arquivo_id])
  @@index([banner_sys_arquivo_id])
  @@index([ativo])
  @@map("par_parceiro_tema")
}

// =========================================================
// CRD — CARDÁPIO
// =========================================================

model CrdCategoria {
  id Int @id @default(autoincrement())

  par_parceiro_id Int

  nome      String  @db.VarChar(120)
  descricao String? @db.VarChar(500)

  ordem Int @default(0)
  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  par_parceiro ParParceiro @relation(fields: [par_parceiro_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  crd_itens CrdItem[]

  @@index([par_parceiro_id])
  @@index([par_parceiro_id, ativo])
  @@index([par_parceiro_id, ordem])
  @@index([deleted_at])
  @@map("crd_categoria")
}

model CrdItem {
  id Int @id @default(autoincrement())

  par_parceiro_id       Int
  crd_categoria_id      Int
  imagem_sys_arquivo_id Int?

  nome      String  @db.VarChar(150)
  descricao String? @db.Text

  preco Decimal @db.Decimal(10, 2)

  ordem Int @default(0)
  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  par_parceiro ParParceiro @relation(fields: [par_parceiro_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  crd_categoria CrdCategoria @relation(fields: [crd_categoria_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  imagem_sys_arquivo SysArquivo? @relation("CrdItemImagem", fields: [imagem_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  crd_promocao_itens CrdPromocaoItem[]

  @@index([par_parceiro_id])
  @@index([crd_categoria_id])
  @@index([imagem_sys_arquivo_id])
  @@index([par_parceiro_id, ativo])
  @@index([par_parceiro_id, crd_categoria_id, ativo])
  @@index([crd_categoria_id, ordem])
  @@index([deleted_at])
  @@map("crd_item")
}

model CrdPromocao {
  id Int @id @default(autoincrement())

  par_parceiro_id       Int
  imagem_sys_arquivo_id Int?

  titulo    String  @db.VarChar(150)
  descricao String? @db.Text

  preco_promocional Decimal? @db.Decimal(10, 2)

  validade_inicio DateTime? @db.Date
  validade_fim    DateTime? @db.Date

  ordem     Int @default(0)
  ativo     Int @default(1)
  exibir_tv Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  par_parceiro ParParceiro @relation(fields: [par_parceiro_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  imagem_sys_arquivo SysArquivo? @relation("CrdPromocaoImagem", fields: [imagem_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  crd_promocao_itens    CrdPromocaoItem[]
  crd_promocao_horarios CrdPromocaoHorario[]

  tv_exibicao TvExibicao?

  @@index([par_parceiro_id])
  @@index([imagem_sys_arquivo_id])
  @@index([par_parceiro_id, ativo])
  @@index([par_parceiro_id, ativo, exibir_tv])
  @@index([validade_inicio, validade_fim])
  @@index([ordem])
  @@index([deleted_at])
  @@map("crd_promocao")
}

model CrdPromocaoItem {
  id Int @id @default(autoincrement())

  crd_promocao_id Int
  crd_item_id     Int

  ordem Int @default(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  crd_promocao CrdPromocao @relation(fields: [crd_promocao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  crd_item     CrdItem     @relation(fields: [crd_item_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([crd_promocao_id, crd_item_id])
  @@index([crd_promocao_id, ordem])
  @@index([crd_item_id])
  @@map("crd_promocao_item")
}

model CrdPromocaoHorario {
  id Int @id @default(autoincrement())

  crd_promocao_id Int

  dia_semana Int

  hora_inicio DateTime @db.Time(0)
  hora_fim    DateTime @db.Time(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  crd_promocao CrdPromocao @relation(fields: [crd_promocao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([crd_promocao_id])
  @@index([dia_semana, hora_inicio, hora_fim])
  @@map("crd_promocao_horario")
}

// =========================================================
// TV — PROGRAMAÇÃO
// =========================================================

model TvExibicaoTipo {
  id Int @id @default(autoincrement())

  codigo    String  @unique @db.VarChar(50)
  nome      String  @db.VarChar(100)
  descricao String? @db.VarChar(255)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  tv_exibicoes TvExibicao[]

  @@index([ativo])
  @@map("tv_exibicao_tipo")
}

model TvExibicao {
  id Int @id @default(autoincrement())

  tv_exibicao_tipo_id Int

  // null = conteúdo da AAACCU.
  // preenchido = conteúdo pertencente ao parceiro.
  // /tv geral agrega automaticamente AAACCU + parceiros.
  par_parceiro_id Int?

  // Fontes existentes. No máximo uma delas deve ser preenchida.
  // Para tipo "divulgacao", ambas permanecem null e os campos próprios
  // abaixo representam o conteúdo.
  cad_evento_id   Int? @unique
  crd_promocao_id Int? @unique

