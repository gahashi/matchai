generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =========================================================
// SYS — USUÁRIOS / AUTENTICAÇÃO
// =========================================================

model SysUsuarioTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(50)
  nome       String    @db.VarChar(100)
  descricao  String?   @db.VarChar(255)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_usuarios SysUsuario[]

  @@map("sys_usuario_tipo")
}

model SysUsuario {
  id                    Int     @id @default(autoincrement())
  sys_usuario_tipo_id   Int
  nome                  String  @db.VarChar(150)
  nickname              String  @unique @db.VarChar(50)
  email                 String  @unique @db.VarChar(150)
  telefone              String? @db.VarChar(30)
  documento             String? @db.VarChar(30)
  avatar_sys_arquivo_id Int?
  ativo                 Int     @default(1)

  perfil_completo     Int       @default(0)
  email_verificado_at DateTime? @db.DateTime(0)
  ultimo_login_at     DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  sys_usuario_tipo SysUsuarioTipo @relation(fields: [sys_usuario_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  avatar_sys_arquivo SysArquivo? @relation("SysUsuarioAvatar", fields: [avatar_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  sys_auth_user                User?
  sys_auth_login_logs          SysAuthLoginLog[]
  sys_email_logs               SysEmailLog[]
  sys_email_verification_codes SysEmailVerificationCode[]

  sys_arquivos_criados SysArquivo[] @relation("SysArquivoCriadoPor")

  vnd_pedidos VndPedido[]

  soc_socios SocSocio[]

  vnd_pedido_historicos_operados VndPedidoHistorico[]

  @@index([sys_usuario_tipo_id])
  @@index([ativo])
  @@index([deleted_at])
  @@map("sys_usuario")
}

// =========================================================
// BETTER AUTH
//
// Mantemos os nomes esperados pelo Better Auth.
// As tabelas físicas continuam prefixadas com sys_auth_.
// =========================================================

model User {
  id            String   @id @db.VarChar(191)
  name          String   @db.VarChar(150)
  email         String   @unique @db.VarChar(150)
  emailVerified Boolean  @default(false)
  image         String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @updatedAt @db.DateTime(0)

  sysUsuarioId Int        @unique @map("sys_usuario_id")
  sys_usuario  SysUsuario @relation(fields: [sysUsuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sessions Session[]
  accounts Account[]

  @@index([sysUsuarioId], map: "sys_auth_user_fk1")
  @@map("sys_auth_user")
}

model Session {
  id        String   @id @db.VarChar(191)
  expiresAt DateTime @db.DateTime(0)
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  userId String @map("user_id") @db.VarChar(191)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "sys_auth_session_fk1")
  @@map("sys_auth_session")
}

model Account {
  id         String @id @db.VarChar(191)
  accountId  String @map("account_id") @db.VarChar(191)
  providerId String @map("provider_id") @db.VarChar(191)
  userId     String @map("user_id") @db.VarChar(191)

  accessToken  String? @map("access_token") @db.Text
  refreshToken String? @map("refresh_token") @db.Text
  idToken      String? @map("id_token") @db.Text

  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.DateTime(0)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.DateTime(0)

  scope    String? @db.Text
  password String? @db.Text

  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "sys_auth_account_fk1")
  @@map("sys_auth_account")
}

model Verification {
  id         String    @id @db.VarChar(191)
  identifier String    @db.VarChar(191)
  value      String    @db.Text
  expiresAt  DateTime  @db.DateTime(0)
  createdAt  DateTime? @default(now()) @db.DateTime(0)
  updatedAt  DateTime? @updatedAt @db.DateTime(0)

  @@index([identifier])
  @@map("sys_auth_verification")
}

model SysAuthLoginLog {
  id             Int  @id @default(autoincrement())
  sys_usuario_id Int?

  email  String? @db.VarChar(150)
  evento String  @db.VarChar(80)
  status String  @db.VarChar(50)

  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  device_text   String? @db.VarChar(255)
  location_text String? @db.VarChar(255)

  error_message String? @db.Text
  metadata_text String? @db.Text

  created_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([sys_usuario_id])
  @@index([email])
  @@index([evento])
  @@index([status])
  @@index([created_at])
  @@map("sys_auth_login_log")
}

// =========================================================
// SYS — E-MAIL
// =========================================================

model SysEmailLog {
  id             Int  @id @default(autoincrement())
  sys_usuario_id Int?

  email_to   String @db.VarChar(180)
  email_from String @db.VarChar(180)
  subject    String @db.VarChar(255)

  template String? @db.VarChar(100)

  provider String @default("smtp") @db.VarChar(50)
  status   String @default("sent") @db.VarChar(50)

  message_id    String? @db.VarChar(255)
  error_message String? @db.Text
  metadata_text String? @db.Text

  sent_at    DateTime? @db.DateTime(0)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([sys_usuario_id])
  @@index([email_to])
  @@index([status])
  @@index([created_at])
  @@map("sys_email_log")
}

model SysEmailVerificationCode {
  id             Int  @id @default(autoincrement())
  sys_usuario_id Int?

  email String @db.VarChar(180)

  tipo String @default("email_verification") @db.VarChar(80)

  codigo_hash String @db.VarChar(255)

  tentativas     Int @default(0)
  max_tentativas Int @default(5)

  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([sys_usuario_id])
  @@index([email])
  @@index([tipo])
  @@index([expires_at])
  @@map("sys_email_verification_code")
}

// =========================================================
// SYS — ARQUIVOS / MINIO
// =========================================================

model SysArquivoDisco {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(40)
  nome       String    @db.VarChar(80)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_arquivos SysArquivo[]

  @@map("sys_arquivo_disco")
}

model SysArquivoVisibilidade {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(40)
  nome       String    @db.VarChar(80)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_arquivos SysArquivo[]

  @@map("sys_arquivo_visibilidade")
}

model SysArquivoTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(60)
  nome       String    @db.VarChar(120)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_arquivos SysArquivo[]

  @@map("sys_arquivo_tipo")
}

model SysArquivo {
  id                          Int  @id @default(autoincrement())
  sys_arquivo_disco_id        Int
  sys_arquivo_visibilidade_id Int
  sys_arquivo_tipo_id         Int?

  bucket        String? @db.VarChar(120)
  file_key      String  @db.VarChar(500)
  public_url    String? @db.VarChar(1000)
  original_name String  @db.VarChar(255)
  mime_type     String  @db.VarChar(120)
  size_bytes    Int
  content_hash  String? @db.VarChar(128)

  created_by_sys_usuario_id Int?

  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)
  storage_deleted_at DateTime? @db.DateTime(0)

  sys_arquivo_disco SysArquivoDisco @relation(fields: [sys_arquivo_disco_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sys_arquivo_visibilidade SysArquivoVisibilidade @relation(fields: [sys_arquivo_visibilidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sys_arquivo_tipo SysArquivoTipo? @relation(fields: [sys_arquivo_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  created_by_sys_usuario SysUsuario? @relation("SysArquivoCriadoPor", fields: [created_by_sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  sys_usuarios_avatar SysUsuario[] @relation("SysUsuarioAvatar")

  prd_produto_imagens PrdProdutoImagem[]

  cad_eventos_banner CadEvento[] @relation("CadEventoBanner")

  soc_planos_banner SocPlano[] @relation("SocPlanoBanner")

  @@index([sys_arquivo_disco_id])
  @@index([sys_arquivo_visibilidade_id])
  @@index([sys_arquivo_tipo_id])
  @@index([file_key])
  @@index([content_hash])
  @@index([created_by_sys_usuario_id])
  @@index([deleted_at])
  @@map("sys_arquivo")
}

// =========================================================
// CAD — LINKS PÚBLICOS
// =========================================================

model CadLink {
  id Int @id @default(autoincrement())

  titulo    String  @db.VarChar(120)
  descricao String? @db.VarChar(255)

  url  String  @db.VarChar(1000)
  icon String? @db.VarChar(100)

  ordem    Int @default(0)
  destaque Int @default(0)
  ativo    Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@index([ativo, ordem])
  @@index([deleted_at])
  @@map("cad_link")
}

// =========================================================
// CAD — EVENTOS / LINKS TEMPORÁRIOS
// =========================================================

model CadEvento {
  id Int @id @default(autoincrement())

  titulo    String  @db.VarChar(150)
  descricao String? @db.Text
  url       String? @db.VarChar(1000)

  banner_sys_arquivo_id Int?

  evento_at DateTime? @db.DateTime(0)

  inicio_exibicao DateTime? @db.DateTime(0)
  fim_exibicao    DateTime? @db.DateTime(0)

  ordem           Int @default(0)
  destaque        Int @default(0)
  ativo           Int @default(1)
  visivel_publico Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  banner_sys_arquivo SysArquivo? @relation("CadEventoBanner", fields: [banner_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([ativo])
  @@index([ativo, visivel_publico])
  @@index([inicio_exibicao, fim_exibicao])
  @@index([evento_at])
  @@index([banner_sys_arquivo_id])
  @@index([deleted_at])
  @@map("cad_evento")
}

// =========================================================
// PRD — PRODUTOS
// =========================================================

model PrdProdutoTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(50)
  nome       String    @db.VarChar(100)
  descricao  String?   @db.VarChar(255)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  prd_produtos PrdProduto[]

  @@map("prd_produto_tipo")
}

model PrdProduto {
  id                  Int @id @default(autoincrement())
  prd_produto_tipo_id Int

  codigo String @unique @db.VarChar(60)
  slug   String @unique @db.VarChar(150)

  nome      String  @db.VarChar(150)
  descricao String? @db.Text

  preco_custo  Decimal? @db.Decimal(10, 2)
  preco_normal Decimal  @db.Decimal(10, 2)
  preco_socio  Decimal? @db.Decimal(10, 2)

  controla_estoque Int  @default(0)
  estoque_atual    Int?

  ativo    Int @default(1)
  destaque Int @default(0)

  visivel_publico Int @default(1)

  inicio_exibicao DateTime? @db.DateTime(0)
  fim_exibicao    DateTime? @db.DateTime(0)

  exibir_apos_encerramento Int @default(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  prd_produto_tipo PrdProdutoTipo @relation(fields: [prd_produto_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  prd_produto_imagens   PrdProdutoImagem[]
  prd_produto_variacoes PrdProdutoVariacao[]

  vnd_campanha_produtos VndCampanhaProduto[]
  vnd_pedido_itens      VndPedidoItem[]

  soc_planos SocPlano[]

  @@index([prd_produto_tipo_id])
  @@index([ativo])
  @@index([ativo, visivel_publico])
  @@index([inicio_exibicao, fim_exibicao])
  @@index([destaque])
  @@index([deleted_at])
  @@map("prd_produto")
}

model PrdProdutoImagem {
  id Int @id @default(autoincrement())

  prd_produto_id Int
  sys_arquivo_id Int

  ordem     Int @default(0)
  principal Int @default(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  prd_produto PrdProduto @relation(fields: [prd_produto_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  sys_arquivo SysArquivo @relation(fields: [sys_arquivo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([prd_produto_id, sys_arquivo_id])
  @@index([prd_produto_id, principal, ordem])
  @@index([sys_arquivo_id])
  @@map("prd_produto_imagem")
}

model PrdProdutoVariacao {
  id Int @id @default(autoincrement())

  prd_produto_id Int

  sku  String? @unique @db.VarChar(80)
  nome String  @db.VarChar(120)

  atributo_1 String? @db.VarChar(60)
  valor_1    String? @db.VarChar(60)
  atributo_2 String? @db.VarChar(60)
  valor_2    String? @db.VarChar(60)

  ordem Int @default(0)

  estoque_atual Int?

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  prd_produto PrdProduto @relation(fields: [prd_produto_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_pedido_itens VndPedidoItem[]

  @@index([prd_produto_id, ativo])
  @@index([deleted_at])
  @@map("prd_produto_variacao")
}

// =========================================================
// VND — CAMPANHAS / PRÉ-VENDAS
// =========================================================

model VndCampanhaStatus {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  color String? @db.VarChar(30)
  icon  String? @db.VarChar(60)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  vnd_campanhas VndCampanha[]

  @@map("vnd_campanha_status")
}

model VndCampanha {
  id                     Int @id @default(autoincrement())
  vnd_campanha_status_id Int

  codigo String @unique @db.VarChar(60)
  slug   String @unique @db.VarChar(150)

  nome      String  @db.VarChar(150)
  descricao String? @db.Text

  inicio_at DateTime? @db.DateTime(0)
  fim_at    DateTime? @db.DateTime(0)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  vnd_campanha_status VndCampanhaStatus @relation(fields: [vnd_campanha_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_campanha_produtos VndCampanhaProduto[]

  vnd_pedidos      VndPedido[]
  vnd_pedido_itens VndPedidoItem[]

  @@index([vnd_campanha_status_id])
  @@index([inicio_at, fim_at])
  @@index([ativo])
  @@index([deleted_at])
  @@map("vnd_campanha")
}

model VndCampanhaProduto {
  id Int @id @default(autoincrement())

  vnd_campanha_id Int
  prd_produto_id  Int

  preco_normal Decimal? @db.Decimal(10, 2)
  preco_socio  Decimal? @db.Decimal(10, 2)

  limite_por_cliente Int?

  ordem Int @default(0)
  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  vnd_campanha VndCampanha @relation(fields: [vnd_campanha_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  prd_produto PrdProduto @relation(fields: [prd_produto_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([vnd_campanha_id, prd_produto_id])
  @@index([vnd_campanha_id, ativo])
  @@index([prd_produto_id])
  @@map("vnd_campanha_produto")
}

// =========================================================
// SOC — ASSOCIAÇÕES / SÓCIOS
// =========================================================

model SocSocioStatus {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  color String? @db.VarChar(30)
  icon  String? @db.VarChar(60)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  soc_socios SocSocio[]

  @@map("soc_socio_status")
}

model SocSocioOrigem {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  soc_socios SocSocio[]

  @@map("soc_socio_origem")
}

model SocPlano {
  id Int @id @default(autoincrement())

  prd_produto_id Int?

  banner_sys_arquivo_id Int?

  codigo String @unique @db.VarChar(60)
  nome   String @db.VarChar(150)

  descricao String? @db.Text

  duracao_dias Int

  ativo           Int @default(1)
  visivel_publico Int @default(1)

  inicio_exibicao DateTime? @db.DateTime(0)
  fim_exibicao    DateTime? @db.DateTime(0)

  exibir_apos_encerramento Int @default(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  prd_produto PrdProduto? @relation(fields: [prd_produto_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  banner_sys_arquivo SysArquivo? @relation("SocPlanoBanner", fields: [banner_sys_arquivo_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  soc_socios SocSocio[]

  @@index([prd_produto_id])
  @@index([banner_sys_arquivo_id])
  @@index([ativo])
  @@index([ativo, visivel_publico])
  @@index([inicio_exibicao, fim_exibicao])
  @@index([deleted_at])
  @@map("soc_plano")
}

model SocSocio {
  id Int @id @default(autoincrement())

  sys_usuario_id      Int
  soc_plano_id        Int
  soc_socio_status_id Int
  soc_socio_origem_id Int

  origem_vnd_pedido_item_id Int?

  inicio_at DateTime @db.DateTime(0)
  fim_at    DateTime @db.DateTime(0)

  observacao String? @db.VarChar(500)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  soc_plano SocPlano @relation(fields: [soc_plano_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  soc_socio_status SocSocioStatus @relation(fields: [soc_socio_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  soc_socio_origem SocSocioOrigem @relation(fields: [soc_socio_origem_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  origem_vnd_pedido_item VndPedidoItem? @relation("SocSocioOrigemPedidoItem", fields: [origem_vnd_pedido_item_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sys_usuario_id, soc_socio_status_id, fim_at])
  @@index([soc_plano_id])
  @@index([origem_vnd_pedido_item_id])
  @@map("soc_socio")
}

// =========================================================
// VND — PEDIDOS
// =========================================================

model VndPedidoStatus {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  color String? @db.VarChar(30)
  icon  String? @db.VarChar(60)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  vnd_pedidos           VndPedido[]
  vnd_pedido_historicos VndPedidoHistorico[]

  @@map("vnd_pedido_status")
}

model VndEntregaTipo {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  vnd_pedidos VndPedido[]

  @@map("vnd_entrega_tipo")
}

model VndPedido {
  id Int @id @default(autoincrement())

  codigo String @unique @db.VarChar(20)

  sys_usuario_id       Int?
  vnd_campanha_id      Int?
  vnd_pedido_status_id Int
  vnd_entrega_tipo_id  Int?

  cliente_nome     String  @db.VarChar(150)
  cliente_email    String? @db.VarChar(180)
  cliente_telefone String  @db.VarChar(30)

  entrega_endereco String? @db.VarChar(500)
  retirada_local   String? @db.VarChar(255)

  observacao_cliente String? @db.VarChar(500)

  valor_produtos  Decimal @db.Decimal(10, 2)
  valor_desconto  Decimal @default(0) @db.Decimal(10, 2)
  valor_frete     Decimal @default(0) @db.Decimal(10, 2)
  valor_acrescimo Decimal @default(0) @db.Decimal(10, 2)
  valor_total     Decimal @db.Decimal(10, 2)

  created_at   DateTime? @db.DateTime(0)
  updated_at   DateTime? @db.DateTime(0)
  cancelado_at DateTime? @db.DateTime(0)
  concluido_at DateTime? @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_campanha VndCampanha? @relation(fields: [vnd_campanha_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_pedido_status VndPedidoStatus @relation(fields: [vnd_pedido_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_entrega_tipo VndEntregaTipo? @relation(fields: [vnd_entrega_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_pedido_itens      VndPedidoItem[]
  vnd_pedido_historicos VndPedidoHistorico[]

  fin_pagamentos FinPagamento[]

  @@index([sys_usuario_id])
  @@index([vnd_campanha_id])
  @@index([vnd_pedido_status_id, created_at])
  @@index([cliente_email])
  @@index([created_at])
  @@map("vnd_pedido")
}

model VndPedidoItem {
  id Int @id @default(autoincrement())

  vnd_pedido_id Int

  prd_produto_id          Int?
  prd_produto_variacao_id Int?

  vnd_campanha_id Int?

  produto_codigo_snapshot String  @db.VarChar(60)
  produto_nome_snapshot   String  @db.VarChar(150)
  variacao_snapshot       String? @db.VarChar(120)

  quantidade Int

  preco_tabela   Decimal @db.Decimal(10, 2)
  preco_unitario Decimal @db.Decimal(10, 2)

  valor_desconto Decimal @default(0) @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  socio_aplicado Int @default(0)

  personalizacao_nome   String? @db.VarChar(100)
  personalizacao_numero String? @db.VarChar(20)

  observacao String? @db.VarChar(500)

  created_at DateTime? @db.DateTime(0)

  vnd_pedido VndPedido @relation(fields: [vnd_pedido_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  prd_produto PrdProduto? @relation(fields: [prd_produto_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  prd_produto_variacao PrdProdutoVariacao? @relation(fields: [prd_produto_variacao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_campanha VndCampanha? @relation(fields: [vnd_campanha_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  soc_socios_gerados SocSocio[] @relation("SocSocioOrigemPedidoItem")

  @@index([vnd_pedido_id])
  @@index([prd_produto_id])
  @@index([prd_produto_variacao_id])
  @@index([vnd_campanha_id])
  @@map("vnd_pedido_item")
}

model VndPedidoHistorico {
  id Int @id @default(autoincrement())

  vnd_pedido_id        Int
  vnd_pedido_status_id Int
  sys_usuario_id       Int?

  observacao String? @db.VarChar(500)

  created_at DateTime? @db.DateTime(0)

  vnd_pedido VndPedido @relation(fields: [vnd_pedido_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_pedido_status VndPedidoStatus @relation(fields: [vnd_pedido_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sys_usuario_operador SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([vnd_pedido_id, created_at])
  @@index([sys_usuario_id])
  @@index([vnd_pedido_status_id])
  @@map("vnd_pedido_historico")
}

// =========================================================
// FIN — PAGAMENTOS
//
// Manual agora.
// Mercado Pago depois sem alterar estrutura de pedido.
// =========================================================

model FinPagamentoStatus {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  color String? @db.VarChar(30)
  icon  String? @db.VarChar(60)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  fin_pagamentos FinPagamento[]

  @@map("fin_pagamento_status")
}

model FinPagamentoMetodo {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  fin_pagamentos FinPagamento[]

  @@map("fin_pagamento_metodo")
}

model FinPagamento {
  id Int @id @default(autoincrement())

  vnd_pedido_id Int

  fin_pagamento_status_id Int
  fin_pagamento_metodo_id Int

  valor         Decimal  @db.Decimal(10, 2)
  taxa_gateway  Decimal? @db.Decimal(10, 2)
  valor_liquido Decimal? @db.Decimal(10, 2)

  provider String? @db.VarChar(50)

  external_id        String? @db.VarChar(191)
  external_reference String? @db.VarChar(191)

  idempotency_key String? @unique @db.VarChar(191)

  qr_code_text String? @db.Text
  payment_url  String? @db.VarChar(1000)

  aprovado_at  DateTime? @db.DateTime(0)
  expirado_at  DateTime? @db.DateTime(0)
  cancelado_at DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  vnd_pedido VndPedido @relation(fields: [vnd_pedido_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  fin_pagamento_status FinPagamentoStatus @relation(fields: [fin_pagamento_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  fin_pagamento_metodo FinPagamentoMetodo @relation(fields: [fin_pagamento_metodo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([vnd_pedido_id])
  @@index([fin_pagamento_status_id])
  @@index([fin_pagamento_metodo_id])
  @@index([provider, external_id])
  @@index([created_at])
  @@map("fin_pagamento")
}
