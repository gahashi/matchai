generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model SysUsuario {
  id                    Int     @id @default(autoincrement())
  nome                  String  @db.VarChar(150)
  nickname              String  @unique @db.VarChar(50)
  email                 String  @unique @db.VarChar(150)
  telefone              String? @db.VarChar(30)
  senha_hash            String? @db.VarChar(255)
  codigo_aluno          String? @db.VarChar(50)
  documento             String? @db.VarChar(30)
  avatar_sys_arquivo_id Int?
  avatar_file_key       String? @db.VarChar(500)
  avatar_url            String? @db.VarChar(1000)
  ativo                 Int     @default(1)

  perfil_completo     Int       @default(0)
  email_verificado_at DateTime? @db.DateTime(0)
  ultimo_login_at     DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  sys_usuario_role       SysUsuarioRole[]
  sys_usuario_permission SysUsuarioPermission[]
  atl_atletica_membro    AtlAtleticaMembro[]

  sys_auth_login_log SysAuthLoginLog[]

  sys_auth_user             User?
  sysEmailLogs              SysEmailLog[]
  sysEmailVerificationCodes SysEmailVerificationCode[]

  @@map("sys_usuario")
}

model SysRoleEscopo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_role SysRole[]

  @@map("sys_role_escopo")
}

model SysRole {
  id                 Int       @id @default(autoincrement())
  codigo             String    @unique @db.VarChar(100)
  nome               String    @db.VarChar(150)
  descricao          String?   @db.Text
  sys_role_escopo_id Int
  ativo              Int       @default(1)
  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)

  sys_role_escopo     SysRoleEscopo       @relation(fields: [sys_role_escopo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_role_permission SysRolePermission[]
  sys_usuario_role    SysUsuarioRole[]

  @@index([sys_role_escopo_id], map: "sys_role_fk1")
  @@index([ativo])
  @@map("sys_role")
}

model SysPermission {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  modulo     String    @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_role_permission    SysRolePermission[]
  sys_usuario_permission SysUsuarioPermission[]

  @@index([ativo])
  @@index([modulo])
  @@map("sys_permission")
}

model SysRolePermission {
  id                Int       @id @default(autoincrement())
  sys_role_id       Int
  sys_permission_id Int
  ativo             Int       @default(1)
  created_at        DateTime? @db.DateTime(0)
  updated_at        DateTime? @db.DateTime(0)

  sys_role       SysRole       @relation(fields: [sys_role_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_permission SysPermission @relation(fields: [sys_permission_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sys_role_id, sys_permission_id], map: "uk_sys_role_permission")
  @@index([sys_role_id], map: "sys_role_permission_fk1")
  @@index([sys_permission_id], map: "sys_role_permission_fk2")
  @@map("sys_role_permission")
}

model SysUsuarioRole {
  id              Int       @id @default(autoincrement())
  sys_usuario_id  Int
  sys_role_id     Int
  atl_atletica_id Int?
  ativo           Int       @default(1)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
  deleted_at      DateTime? @db.DateTime(0)

  sys_usuario  SysUsuario   @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_role     SysRole      @relation(fields: [sys_role_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica AtlAtletica? @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sys_usuario_id, sys_role_id, atl_atletica_id], map: "uk_sys_usuario_role_contexto")
  @@index([sys_usuario_id], map: "sys_usuario_role_fk1")
  @@index([sys_role_id], map: "sys_usuario_role_fk2")
  @@index([atl_atletica_id], map: "sys_usuario_role_fk3")
  @@map("sys_usuario_role")
}

model SysUsuarioPermissionTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_usuario_permission SysUsuarioPermission[]

  @@map("sys_usuario_permission_tipo")
}

model SysUsuarioPermission {
  id                             Int       @id @default(autoincrement())
  sys_usuario_id                 Int
  sys_permission_id              Int
  sys_usuario_permission_tipo_id Int
  atl_atletica_id                Int?
  motivo                         String?   @db.VarChar(255)
  ativo                          Int       @default(1)
  created_at                     DateTime? @db.DateTime(0)
  updated_at                     DateTime? @db.DateTime(0)
  deleted_at                     DateTime? @db.DateTime(0)

  sys_usuario                 SysUsuario               @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_permission              SysPermission            @relation(fields: [sys_permission_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_usuario_permission_tipo SysUsuarioPermissionTipo @relation(fields: [sys_usuario_permission_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica                AtlAtletica?             @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sys_usuario_id, sys_permission_id, atl_atletica_id], map: "uk_sys_usuario_permission_contexto")
  @@index([sys_usuario_id], map: "sys_usuario_permission_fk1")
  @@index([sys_permission_id], map: "sys_usuario_permission_fk2")
  @@index([sys_usuario_permission_tipo_id], map: "sys_usuario_permission_fk3")
  @@index([atl_atletica_id], map: "sys_usuario_permission_fk4")
  @@map("sys_usuario_permission")
}

model EduInstituicao {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(150)
  abreviacao String    @db.VarChar(30)
  cidade     String?   @db.VarChar(100)
  estado     String?   @db.VarChar(2)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  edu_instituicao_curso EduInstituicaoCurso[]
  atl_atletica          AtlAtletica[]

  @@index([abreviacao])
  @@index([ativo])
  @@map("edu_instituicao")
}

model EduCurso {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(150)
  abreviacao String    @db.VarChar(30)
  periodos   Int?
  fundado_at DateTime? @db.Date
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  edu_instituicao_curso EduInstituicaoCurso[]
  atl_atletica_curso    AtlAtleticaCurso[]

  @@index([abreviacao])
  @@index([ativo])
  @@map("edu_curso")
}

model EduInstituicaoCurso {
  id                 Int       @id @default(autoincrement())
  edu_instituicao_id Int
  edu_curso_id       Int
  ativo              Int       @default(1)
  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)

  edu_instituicao EduInstituicao @relation(fields: [edu_instituicao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edu_curso       EduCurso       @relation(fields: [edu_curso_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([edu_instituicao_id, edu_curso_id], map: "uk_edu_instituicao_curso")
  @@index([edu_instituicao_id], map: "edu_instituicao_curso_fk1")
  @@index([edu_curso_id], map: "edu_instituicao_curso_fk2")
  @@map("edu_instituicao_curso")
}

model AtlAtletica {
  id                 Int       @id @default(autoincrement())
  edu_instituicao_id Int
  nome               String    @db.VarChar(150)
  sigla              String    @db.VarChar(30)
  slug               String    @unique @db.VarChar(100)
  mascote            String    @db.VarChar(100)
  descricao          String?   @db.Text
  fundado_at         DateTime? @db.Date
  logo_url           String?   @db.VarChar(255)
  ativo              Int       @default(1)
  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)

  edu_instituicao         EduInstituicao          @relation(fields: [edu_instituicao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica_curso      AtlAtleticaCurso[]
  atl_atletica_cargo      AtlAtleticaCargo[]
  atl_atletica_membro     AtlAtleticaMembro[]
  atl_atletica_tema       AtlAtleticaTema?
  atl_atletica_regimento  AtlAtleticaRegimento[]
  sys_usuario_role        SysUsuarioRole[]
  sys_usuario_permission  SysUsuarioPermission[]
  atl_atletica_assinatura AtlAtleticaAssinatura[]

  @@index([edu_instituicao_id], map: "atl_atletica_fk1")
  @@index([ativo])
  @@map("atl_atletica")
}

model AtlAtleticaCurso {
  id              Int       @id @default(autoincrement())
  atl_atletica_id Int
  edu_curso_id    Int
  principal       Int       @default(0)
  ativo           Int       @default(1)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
  deleted_at      DateTime? @db.DateTime(0)

  atl_atletica AtlAtletica @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edu_curso    EduCurso    @relation(fields: [edu_curso_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([atl_atletica_id, edu_curso_id], map: "uk_atl_atletica_curso")
  @@index([atl_atletica_id], map: "atl_atletica_curso_fk1")
  @@index([edu_curso_id], map: "atl_atletica_curso_fk2")
  @@map("atl_atletica_curso")
}

model AtlCargoTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  atl_cargo AtlCargo[]

  @@map("atl_cargo_tipo")
}

model AtlCargo {
  id                Int       @id @default(autoincrement())
  nome              String    @db.VarChar(100)
  codigo            String    @db.VarChar(100)
  descricao         String?   @db.VarChar(255)
  atl_cargo_tipo_id Int
  atl_atletica_id   Int?
  ativo             Int       @default(1)
  created_at        DateTime? @db.DateTime(0)
  updated_at        DateTime? @db.DateTime(0)
  deleted_at        DateTime? @db.DateTime(0)

  atl_cargo_tipo            AtlCargoTipo             @relation(fields: [atl_cargo_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica_cargo        AtlAtleticaCargo[]
  atl_atletica_membro_cargo AtlAtleticaMembroCargo[]

  @@unique([codigo, atl_atletica_id], map: "uk_atl_cargo_codigo_contexto")
  @@index([atl_cargo_tipo_id], map: "atl_cargo_fk1")
  @@index([atl_atletica_id], map: "atl_cargo_fk2")
  @@index([ativo])
  @@map("atl_cargo")
}

model AtlAtleticaCargo {
  id                    Int       @id @default(autoincrement())
  atl_atletica_id       Int
  atl_cargo_id          Int
  nome_exibicao         String?   @db.VarChar(100)
  descricao_customizada String?   @db.VarChar(255)
  ordem                 Int       @default(0)
  ativo                 Int       @default(1)
  created_at            DateTime? @db.DateTime(0)
  updated_at            DateTime? @db.DateTime(0)
  deleted_at            DateTime? @db.DateTime(0)

  atl_atletica AtlAtletica @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_cargo    AtlCargo    @relation(fields: [atl_cargo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([atl_atletica_id, atl_cargo_id], map: "uk_atl_atletica_cargo")
  @@index([atl_atletica_id], map: "atl_atletica_cargo_fk1")
  @@index([atl_cargo_id], map: "atl_atletica_cargo_fk2")
  @@index([ordem])
  @@map("atl_atletica_cargo")
}

model AtlAtleticaMembroTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  atl_atletica_membro AtlAtleticaMembro[]

  @@map("atl_atletica_membro_tipo")
}

model AtlAtleticaMembroStatus {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  color      String?   @db.VarChar(50)
  icon       String?   @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  atl_atletica_membro AtlAtleticaMembro[]

  @@map("atl_atletica_membro_status")
}

model AtlAtleticaMembro {
  id                            Int       @id @default(autoincrement())
  atl_atletica_id               Int
  sys_usuario_id                Int
  atl_atletica_membro_tipo_id   Int
  atl_atletica_membro_status_id Int
  entrou_at                     DateTime? @db.Date
  saiu_at                       DateTime? @db.Date
  observacao                    String?   @db.Text
  ativo                         Int       @default(1)
  created_at                    DateTime? @db.DateTime(0)
  updated_at                    DateTime? @db.DateTime(0)
  deleted_at                    DateTime? @db.DateTime(0)

  atl_atletica               AtlAtletica              @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_usuario                SysUsuario               @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica_membro_tipo   AtlAtleticaMembroTipo    @relation(fields: [atl_atletica_membro_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica_membro_status AtlAtleticaMembroStatus  @relation(fields: [atl_atletica_membro_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica_membro_cargo  AtlAtleticaMembroCargo[]

  @@unique([atl_atletica_id, sys_usuario_id], map: "uk_atl_atletica_membro")
  @@index([atl_atletica_id], map: "atl_atletica_membro_fk1")
  @@index([sys_usuario_id], map: "atl_atletica_membro_fk2")
  @@index([atl_atletica_membro_tipo_id], map: "atl_atletica_membro_fk3")
  @@index([atl_atletica_membro_status_id], map: "atl_atletica_membro_fk4")
  @@map("atl_atletica_membro")
}

model AtlAtleticaMembroCargo {
  id                     Int       @id @default(autoincrement())
  atl_atletica_membro_id Int
  atl_cargo_id           Int
  inicio_at              DateTime  @db.Date
  fim_at                 DateTime? @db.Date
  atual                  Int       @default(1)
  observacao             String?   @db.Text
  created_at             DateTime? @db.DateTime(0)
  updated_at             DateTime? @db.DateTime(0)
  deleted_at             DateTime? @db.DateTime(0)

  atl_atletica_membro AtlAtleticaMembro @relation(fields: [atl_atletica_membro_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_cargo           AtlCargo          @relation(fields: [atl_cargo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([atl_atletica_membro_id], map: "atl_atletica_membro_cargo_fk1")
  @@index([atl_cargo_id], map: "atl_atletica_membro_cargo_fk2")
  @@index([atual])
  @@map("atl_atletica_membro_cargo")
}

model AtlAtleticaTema {
  id              Int       @id @default(autoincrement())
  atl_atletica_id Int       @unique
  cor_primaria    String    @db.VarChar(20)
  cor_secundaria  String    @db.VarChar(20)
  cor_fundo       String?   @db.VarChar(20)
  cor_texto       String?   @db.VarChar(20)
  logo_url        String?   @db.VarChar(255)
  banner_url      String?   @db.VarChar(255)
  custom_css      String?   @db.Text
  ativo           Int       @default(1)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)

  atl_atletica AtlAtletica @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([atl_atletica_id], map: "atl_atletica_tema_fk1")
  @@map("atl_atletica_tema")
}

model AtlAtleticaRegimento {
  id              Int       @id @default(autoincrement())
  atl_atletica_id Int
  titulo          String    @db.VarChar(150)
  versao          String    @db.VarChar(30)
  conteudo        String    @db.Text
  arquivo_url     String?   @db.VarChar(255)
  aprovado_at     DateTime? @db.Date
  ativo           Int       @default(1)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
  deleted_at      DateTime? @db.DateTime(0)

  atl_atletica AtlAtletica @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([atl_atletica_id, versao], map: "uk_atl_atletica_regimento_versao")
  @@index([atl_atletica_id], map: "atl_atletica_regimento_fk1")
  @@map("atl_atletica_regimento")
}

model SysAssinaturaPlanoPeriodicidade {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_assinatura_plano SysAssinaturaPlano[]

  @@map("sys_assinatura_plano_periodicidade")
}

model SysAssinaturaPlano {
  id                                    Int       @id @default(autoincrement())
  nome                                  String    @db.VarChar(100)
  codigo                                String    @unique @db.VarChar(100)
  descricao                             String?   @db.Text
  valor                                 Decimal   @default(0.00) @db.Decimal(10, 2)
  sys_assinatura_plano_periodicidade_id Int
  limite_membros                        Int?
  limite_eventos                        Int?
  ativo                                 Int       @default(1)
  created_at                            DateTime? @db.DateTime(0)
  updated_at                            DateTime? @db.DateTime(0)
  deleted_at                            DateTime? @db.DateTime(0)

  sys_assinatura_plano_periodicidade SysAssinaturaPlanoPeriodicidade @relation(fields: [sys_assinatura_plano_periodicidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica_assinatura            AtlAtleticaAssinatura[]

  @@index([sys_assinatura_plano_periodicidade_id], map: "sys_assinatura_plano_fk1")
  @@map("sys_assinatura_plano")
}

model AtlAtleticaAssinaturaStatus {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  color      String?   @db.VarChar(50)
  icon       String?   @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  atl_atletica_assinatura AtlAtleticaAssinatura[]

  @@map("atl_atletica_assinatura_status")
}

model AtlAtleticaAssinatura {
  id                                Int       @id @default(autoincrement())
  atl_atletica_id                   Int
  sys_assinatura_plano_id           Int
  atl_atletica_assinatura_status_id Int
  inicio_at                         DateTime  @db.Date
  fim_at                            DateTime? @db.Date
  observacao                        String?   @db.Text
  ativo                             Int       @default(1)
  created_at                        DateTime? @db.DateTime(0)
  updated_at                        DateTime? @db.DateTime(0)
  deleted_at                        DateTime? @db.DateTime(0)

  atl_atletica                   AtlAtletica                 @relation(fields: [atl_atletica_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_assinatura_plano           SysAssinaturaPlano          @relation(fields: [sys_assinatura_plano_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  atl_atletica_assinatura_status AtlAtleticaAssinaturaStatus @relation(fields: [atl_atletica_assinatura_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([atl_atletica_id], map: "atl_atletica_assinatura_fk1")
  @@index([sys_assinatura_plano_id], map: "atl_atletica_assinatura_fk2")
  @@index([atl_atletica_assinatura_status_id], map: "atl_atletica_assinatura_fk3")
  @@map("atl_atletica_assinatura")
}

model User {
  id            String   @id @db.VarChar(191)
  name          String   @db.VarChar(150)
  email         String   @unique @db.VarChar(150)
  emailVerified Boolean  @default(false)
  image         String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @updatedAt @db.DateTime(0)

  sysUsuarioId Int        @unique @map("sys_usuario_id")
  sys_usuario  SysUsuario @relation(fields: [sysUsuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sessions Session[]
  accounts Account[]

  @@index([sysUsuarioId], map: "sys_auth_user_fk1")
  @@map("sys_auth_user")
}

model Session {
  id        String   @id @db.VarChar(191)
  expiresAt DateTime @db.DateTime(0)
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text

  userId String @map("user_id") @db.VarChar(191)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "sys_auth_session_fk1")
  @@map("sys_auth_session")
}

model Account {
  id                    String    @id @db.VarChar(191)
  accountId             String    @map("account_id") @db.VarChar(191)
  providerId            String    @map("provider_id") @db.VarChar(191)
  userId                String    @map("user_id") @db.VarChar(191)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.DateTime(0)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.DateTime(0)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.DateTime(0)
  updatedAt             DateTime  @updatedAt @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId], map: "sys_auth_account_fk1")
  @@map("sys_auth_account")
}

model Verification {
