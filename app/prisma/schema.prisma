}

model SysSolicitacaoDocumentoStatus {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  color      String?   @db.VarChar(50)
  icon       String?   @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_solicitacao_documento SysSolicitacaoDocumento[]

  @@map("sys_solicitacao_documento_status")
}

model SysSolicitacaoDocumento {
  id                                  Int       @id @default(autoincrement())
  sys_solicitacao_id                  Int
  sys_solicitacao_documento_tipo_id   Int
  sys_solicitacao_documento_status_id Int
  sys_arquivo_id                      Int?
  titulo                              String?   @db.VarChar(180)
  descricao                           String?   @db.Text
  observacao                          String?   @db.Text
  ativo                               Int       @default(1)
  created_at                          DateTime? @db.DateTime(0)
  updated_at                          DateTime? @db.DateTime(0)
  deleted_at                          DateTime? @db.DateTime(0)

  sys_solicitacao                  SysSolicitacao                @relation(fields: [sys_solicitacao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_solicitacao_documento_tipo   SysSolicitacaoDocumentoTipo   @relation(fields: [sys_solicitacao_documento_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_solicitacao_documento_status SysSolicitacaoDocumentoStatus @relation(fields: [sys_solicitacao_documento_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_arquivo                      SysArquivo?                   @relation(fields: [sys_arquivo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sys_solicitacao_id], map: "sys_solicitacao_documento_fk1")
  @@index([sys_solicitacao_documento_tipo_id], map: "sys_solicitacao_documento_fk2")
  @@index([sys_solicitacao_documento_status_id], map: "sys_solicitacao_documento_fk3")
  @@index([sys_arquivo_id], map: "sys_solicitacao_documento_fk4")
  @@index([ativo])
  @@index([deleted_at])
  @@map("sys_solicitacao_documento")
}
