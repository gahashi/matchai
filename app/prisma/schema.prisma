model EntEntidadeMembroStatus {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  color      String?   @db.VarChar(50)
  icon       String?   @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  ent_entidade_membro EntEntidadeMembro[]

  @@map("ent_entidade_membro_status")
}

model EntEntidadeMembro {
  id                            Int       @id @default(autoincrement())
  ent_entidade_id               Int
  sys_usuario_id                Int
  ent_entidade_membro_tipo_id   Int
  ent_entidade_membro_status_id Int
  entrou_at                     DateTime? @db.Date
  saiu_at                       DateTime? @db.Date
  observacao                    String?   @db.Text
  ativo                         Int       @default(1)
  created_at                    DateTime? @db.DateTime(0)
  updated_at                    DateTime? @db.DateTime(0)
  deleted_at                    DateTime? @db.DateTime(0)

  ent_entidade               EntEntidade              @relation(fields: [ent_entidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_usuario                SysUsuario               @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_membro_tipo   EntEntidadeMembroTipo    @relation(fields: [ent_entidade_membro_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_membro_status EntEntidadeMembroStatus  @relation(fields: [ent_entidade_membro_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_membro_cargo  EntEntidadeMembroCargo[]

  @@unique([ent_entidade_id, sys_usuario_id], map: "uk_ent_entidade_membro")
  @@index([ent_entidade_id], map: "ent_entidade_membro_fk1")
  @@index([sys_usuario_id], map: "ent_entidade_membro_fk2")
  @@index([ent_entidade_membro_tipo_id], map: "ent_entidade_membro_fk3")
  @@index([ent_entidade_membro_status_id], map: "ent_entidade_membro_fk4")
  @@map("ent_entidade_membro")
}

