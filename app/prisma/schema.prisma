}

model EntCargoTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  ent_cargo EntCargo[]

  @@map("ent_cargo_tipo")
}

model EntCargo {
  id                Int       @id @default(autoincrement())
  nome              String    @db.VarChar(100)
  codigo            String    @db.VarChar(100)
  descricao         String?   @db.VarChar(255)
  ent_cargo_tipo_id Int
  ent_entidade_id   Int?
  ativo             Int       @default(1)
  created_at        DateTime? @db.DateTime(0)
  updated_at        DateTime? @db.DateTime(0)
  deleted_at        DateTime? @db.DateTime(0)

  ent_cargo_tipo            EntCargoTipo             @relation(fields: [ent_cargo_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade              EntEntidade?             @relation(fields: [ent_entidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_cargo        EntEntidadeCargo[]
  ent_entidade_membro_cargo EntEntidadeMembroCargo[]

  @@unique([codigo, ent_entidade_id], map: "uk_ent_cargo_codigo_contexto")
  @@index([ent_cargo_tipo_id], map: "ent_cargo_fk1")
  @@index([ent_entidade_id], map: "ent_cargo_fk2")
  @@index([ativo])
  @@map("ent_cargo")
