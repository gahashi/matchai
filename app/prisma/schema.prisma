generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model SysUsuario {
  id                    Int     @id @default(autoincrement())
  nome                  String  @db.VarChar(150)
  nickname              String  @unique @db.VarChar(50)
  email                 String  @unique @db.VarChar(150)
  telefone              String? @db.VarChar(30)
  senha_hash            String? @db.VarChar(255)
  codigo_aluno          String? @db.VarChar(50)
  documento             String? @db.VarChar(30)
  avatar_sys_arquivo_id Int?
  avatar_file_key       String? @db.VarChar(500)
  avatar_url            String? @db.VarChar(1000)
  ativo                 Int     @default(1)

  perfil_completo     Int       @default(0)
  email_verificado_at DateTime? @db.DateTime(0)
  ultimo_login_at     DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  sys_usuario_role            SysUsuarioRole[]
  sys_usuario_permission      SysUsuarioPermission[]
  ent_entidade_membro         EntEntidadeMembro[]
  sys_usuario_polo            SysUsuarioPolo[]
  ent_entidade_criada         EntEntidade[]             @relation("EntEntidadeCriadoPor")
  sys_inbox_item              SysInboxItem[]
  sys_solicitacao_solicitante SysSolicitacao[]          @relation("SysSolicitacaoSolicitante")
  sys_solicitacao_responsavel SysSolicitacao[]          @relation("SysSolicitacaoResponsavel")
  sys_solicitacao_historico   SysSolicitacaoHistorico[]

  sys_auth_login_log SysAuthLoginLog[]

  sys_auth_user             User?
  sysEmailLogs              SysEmailLog[]
  sysEmailVerificationCodes SysEmailVerificationCode[]

  @@map("sys_usuario")
}

model SysRoleEscopo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_role SysRole[]

  @@map("sys_role_escopo")
}

model SysRole {
  id                 Int       @id @default(autoincrement())
  codigo             String    @unique @db.VarChar(100)
  nome               String    @db.VarChar(150)
  descricao          String?   @db.Text
  sys_role_escopo_id Int
  ativo              Int       @default(1)
  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)

  sys_role_escopo     SysRoleEscopo       @relation(fields: [sys_role_escopo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_role_permission SysRolePermission[]
  sys_usuario_role    SysUsuarioRole[]

  @@index([sys_role_escopo_id], map: "sys_role_fk1")
  @@index([ativo])
  @@map("sys_role")
}

model SysPermission {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  modulo     String    @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_role_permission    SysRolePermission[]
  sys_usuario_permission SysUsuarioPermission[]

  @@index([ativo])
  @@index([modulo])
  @@map("sys_permission")
}

model SysRolePermission {
  id                Int       @id @default(autoincrement())
  sys_role_id       Int
  sys_permission_id Int
  ativo             Int       @default(1)
  created_at        DateTime? @db.DateTime(0)
  updated_at        DateTime? @db.DateTime(0)

  sys_role       SysRole       @relation(fields: [sys_role_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_permission SysPermission @relation(fields: [sys_permission_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sys_role_id, sys_permission_id], map: "uk_sys_role_permission")
  @@index([sys_role_id], map: "sys_role_permission_fk1")
  @@index([sys_permission_id], map: "sys_role_permission_fk2")
  @@map("sys_role_permission")
}

model SysUsuarioRole {
  id              Int       @id @default(autoincrement())
  sys_usuario_id  Int
  sys_role_id     Int
  ent_entidade_id Int?
  ativo           Int       @default(1)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
  deleted_at      DateTime? @db.DateTime(0)

  sys_usuario  SysUsuario   @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_role     SysRole      @relation(fields: [sys_role_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade EntEntidade? @relation(fields: [ent_entidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sys_usuario_id, sys_role_id, ent_entidade_id], map: "uk_sys_usuario_role_contexto")
  @@index([sys_usuario_id], map: "sys_usuario_role_fk1")
  @@index([sys_role_id], map: "sys_usuario_role_fk2")
  @@index([ent_entidade_id], map: "sys_usuario_role_fk3")
  @@map("sys_usuario_role")
}

model SysUsuarioPermissionTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  sys_usuario_permission SysUsuarioPermission[]

  @@map("sys_usuario_permission_tipo")
}

model SysUsuarioPermission {
  id                             Int       @id @default(autoincrement())
  sys_usuario_id                 Int
  sys_permission_id              Int
  sys_usuario_permission_tipo_id Int
  ent_entidade_id                Int?
  motivo                         String?   @db.VarChar(255)
  ativo                          Int       @default(1)
  created_at                     DateTime? @db.DateTime(0)
  updated_at                     DateTime? @db.DateTime(0)
  deleted_at                     DateTime? @db.DateTime(0)

  sys_usuario                 SysUsuario               @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_permission              SysPermission            @relation(fields: [sys_permission_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_usuario_permission_tipo SysUsuarioPermissionTipo @relation(fields: [sys_usuario_permission_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade                EntEntidade?             @relation(fields: [ent_entidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sys_usuario_id, sys_permission_id, ent_entidade_id], map: "uk_sys_usuario_permission_contexto")
  @@index([sys_usuario_id], map: "sys_usuario_permission_fk1")
  @@index([sys_permission_id], map: "sys_usuario_permission_fk2")
  @@index([sys_usuario_permission_tipo_id], map: "sys_usuario_permission_fk3")
  @@index([ent_entidade_id], map: "sys_usuario_permission_fk4")
  @@map("sys_usuario_permission")
}

model EduInstituicao {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(150)
  abreviacao String    @db.VarChar(30)
  cidade     String?   @db.VarChar(100)
  estado     String?   @db.VarChar(2)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  edu_instituicao_curso EduInstituicaoCurso[]
  edu_polo              EduPolo[]
  ent_entidade          EntEntidade[]
  sys_solicitacao       SysSolicitacao[]

  @@index([abreviacao])
  @@index([ativo])
  @@map("edu_instituicao")
}

model EduCurso {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(150)
  abreviacao String    @db.VarChar(30)
  periodos   Int?
  fundado_at DateTime? @db.Date
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  edu_instituicao_curso EduInstituicaoCurso[]
  ent_entidade_curso    EntEntidadeCurso[]

  @@index([abreviacao])
  @@index([ativo])
  @@map("edu_curso")
}

model EduInstituicaoCurso {
  id                 Int       @id @default(autoincrement())
  edu_instituicao_id Int
  edu_curso_id       Int
  ativo              Int       @default(1)
  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)

  edu_instituicao EduInstituicao @relation(fields: [edu_instituicao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edu_curso       EduCurso       @relation(fields: [edu_curso_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([edu_instituicao_id, edu_curso_id], map: "uk_edu_instituicao_curso")
  @@index([edu_instituicao_id], map: "edu_instituicao_curso_fk1")
  @@index([edu_curso_id], map: "edu_instituicao_curso_fk2")
  @@map("edu_instituicao_curso")
}

model EduPolo {
  id                 Int       @id @default(autoincrement())
  edu_instituicao_id Int
  codigo             String    @db.VarChar(100)
  nome               String    @db.VarChar(150)
  cidade             String?   @db.VarChar(100)
  estado             String?   @db.VarChar(2)
  ativo              Int       @default(1)
  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
  deleted_at         DateTime? @db.DateTime(0)

  edu_instituicao   EduInstituicao    @relation(fields: [edu_instituicao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sys_usuario_polo  SysUsuarioPolo[]
  ent_entidade_polo EntEntidadePolo[]
  sys_solicitacao   SysSolicitacao[]

  @@unique([edu_instituicao_id, codigo], map: "uk_edu_polo_instituicao_codigo")
  @@index([edu_instituicao_id], map: "edu_polo_fk1")
  @@index([ativo])
  @@map("edu_polo")
}

model SysUsuarioPolo {
  id             Int       @id @default(autoincrement())
  sys_usuario_id Int
  edu_polo_id    Int
  principal      Int       @default(0)
  ativo          Int       @default(1)
  created_at     DateTime? @db.DateTime(0)
  updated_at     DateTime? @db.DateTime(0)
  deleted_at     DateTime? @db.DateTime(0)

  sys_usuario SysUsuario @relation(fields: [sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edu_polo    EduPolo    @relation(fields: [edu_polo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sys_usuario_id, edu_polo_id], map: "uk_sys_usuario_polo")
  @@index([sys_usuario_id], map: "sys_usuario_polo_fk1")
  @@index([edu_polo_id], map: "sys_usuario_polo_fk2")
  @@index([principal])
  @@map("sys_usuario_polo")
}

model EntEntidadeTipo {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  ent_entidade EntEntidade[]

  @@map("ent_entidade_tipo")
}

model EntEntidadeStatus {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  color      String?   @db.VarChar(50)
  icon       String?   @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  ent_entidade EntEntidade[]

  @@map("ent_entidade_status")
}

model EntEntidade {
  id                        Int       @id @default(autoincrement())
  ent_entidade_tipo_id      Int
  ent_entidade_status_id    Int
  edu_instituicao_id        Int
  criado_por_sys_usuario_id Int?
  nome                      String    @db.VarChar(150)
  apelido                   String?   @db.VarChar(120)
  sigla                     String    @db.VarChar(30)
  slug                      String    @unique @db.VarChar(100)
  mascote                   String    @db.VarChar(100)
  descricao                 String?   @db.Text
  fundado_at                DateTime? @db.Date
  logo_url                  String?   @db.VarChar(255)
  ativo                     Int       @default(1)
  created_at                DateTime? @db.DateTime(0)
  updated_at                DateTime? @db.DateTime(0)
  deleted_at                DateTime? @db.DateTime(0)

  ent_entidade_tipo       EntEntidadeTipo         @relation(fields: [ent_entidade_tipo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_status     EntEntidadeStatus       @relation(fields: [ent_entidade_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  criado_por_sys_usuario  SysUsuario?             @relation("EntEntidadeCriadoPor", fields: [criado_por_sys_usuario_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_gestao     EntEntidadeGestao[]
  edu_instituicao         EduInstituicao          @relation(fields: [edu_instituicao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_curso      EntEntidadeCurso[]
  ent_entidade_cargo      EntEntidadeCargo[]
  ent_cargo               EntCargo[]
  ent_entidade_membro     EntEntidadeMembro[]
  ent_entidade_tema       EntEntidadeTema?
  ent_entidade_regimento  EntEntidadeRegimento[]
  sys_usuario_role        SysUsuarioRole[]
  sys_usuario_permission  SysUsuarioPermission[]
  ent_entidade_assinatura EntEntidadeAssinatura[]
  entEntidadePolos        EntEntidadePolo[]
  sysSolicitacaos         SysSolicitacao[]

  @@index([ent_entidade_tipo_id], map: "ent_entidade_fk1")
  @@index([ent_entidade_status_id], map: "ent_entidade_fk2")
  @@index([edu_instituicao_id], map: "ent_entidade_fk3")
  @@index([criado_por_sys_usuario_id], map: "ent_entidade_fk4")
  @@index([ativo])
  @@map("ent_entidade")
}

model EntEntidadeCurso {
  id              Int       @id @default(autoincrement())
  ent_entidade_id Int
  edu_curso_id    Int
  principal       Int       @default(0)
  ativo           Int       @default(1)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
  deleted_at      DateTime? @db.DateTime(0)

  ent_entidade EntEntidade @relation(fields: [ent_entidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edu_curso    EduCurso    @relation(fields: [edu_curso_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ent_entidade_id, edu_curso_id], map: "uk_ent_entidade_curso")
  @@index([ent_entidade_id], map: "ent_entidade_curso_fk1")
  @@index([edu_curso_id], map: "ent_entidade_curso_fk2")
  @@map("ent_entidade_curso")
}

model EntEntidadePolo {
  id              Int       @id @default(autoincrement())
  ent_entidade_id Int
  edu_polo_id     Int
  principal       Int       @default(0)
  ativo           Int       @default(1)
  created_at      DateTime? @db.DateTime(0)
  updated_at      DateTime? @db.DateTime(0)
  deleted_at      DateTime? @db.DateTime(0)

  ent_entidade EntEntidade @relation(fields: [ent_entidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  edu_polo     EduPolo     @relation(fields: [edu_polo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ent_entidade_id, edu_polo_id], map: "uk_ent_entidade_polo")
  @@index([ent_entidade_id], map: "ent_entidade_polo_fk1")
  @@index([edu_polo_id], map: "ent_entidade_polo_fk2")
  @@index([principal])
  @@map("ent_entidade_polo")
}

model EntEntidadeGestaoStatus {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique @db.VarChar(100)
  nome       String    @db.VarChar(150)
  descricao  String?   @db.Text
  color      String?   @db.VarChar(50)
  icon       String?   @db.VarChar(100)
  ativo      Int       @default(1)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  ent_entidade_gestao EntEntidadeGestao[]

  @@map("ent_entidade_gestao_status")
}

model EntEntidadeGestao {
  id                            Int       @id @default(autoincrement())
  ent_entidade_id               Int
  ent_entidade_gestao_status_id Int
  nome                          String    @db.VarChar(150)
  inicio_at                     DateTime? @db.Date
  fim_at                        DateTime? @db.Date
  observacao                    String?   @db.Text
  ativo                         Int       @default(1)
  created_at                    DateTime? @db.DateTime(0)
  updated_at                    DateTime? @db.DateTime(0)
  deleted_at                    DateTime? @db.DateTime(0)

  ent_entidade               EntEntidade             @relation(fields: [ent_entidade_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ent_entidade_gestao_status EntEntidadeGestaoStatus @relation(fields: [ent_entidade_gestao_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ent_entidade_id, nome], map: "uk_ent_entidade_gestao_nome")
  @@index([ent_entidade_id], map: "ent_entidade_gestao_fk1")
  @@index([ent_entidade_gestao_status_id], map: "ent_entidade_gestao_fk2")
