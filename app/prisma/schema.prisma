  vnd_pedido_item_componente VndPedidoItemComponente? @relation(fields: [vnd_pedido_item_componente_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  prd_produto PrdProduto @relation(fields: [prd_produto_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  prd_produto_variacao PrdProdutoVariacao? @relation(fields: [prd_produto_variacao_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([vnd_pedido_id])
  @@index([vnd_pedido_item_id])
  @@index([vnd_pedido_item_componente_id])
  @@index([prd_produto_id, expira_at])
  @@index([prd_produto_variacao_id, expira_at])
  @@map("vnd_estoque_reserva")
}

model VndPedidoHistorico {
  id Int @id @default(autoincrement())

  vnd_pedido_id        Int
  vnd_pedido_status_id Int
  sys_usuario_id       Int?

  observacao String? @db.VarChar(500)

  created_at DateTime? @db.DateTime(0)

  vnd_pedido VndPedido @relation(fields: [vnd_pedido_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  vnd_pedido_status VndPedidoStatus @relation(fields: [vnd_pedido_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  sys_usuario_operador SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([vnd_pedido_id, created_at])
  @@index([sys_usuario_id])
  @@index([vnd_pedido_status_id])
  @@map("vnd_pedido_historico")
}

// =========================================================
// FIN — PAGAMENTOS
//
// Manual agora.
// Mercado Pago depois sem alterar estrutura de pedido.
// =========================================================

model FinPagamentoStatus {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  color String? @db.VarChar(30)
  icon  String? @db.VarChar(60)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  fin_pagamentos FinPagamento[]

  @@map("fin_pagamento_status")
}

model FinPagamentoMetodo {
  id Int @id @default(autoincrement())

  codigo    String @unique @db.VarChar(50)
  descricao String @db.VarChar(100)

  ativo Int @default(1)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  fin_pagamentos FinPagamento[]

  @@map("fin_pagamento_metodo")
}

model FinPagamento {
  id Int @id @default(autoincrement())

  vnd_pedido_id Int

  fin_pagamento_status_id Int
  fin_pagamento_metodo_id Int

  valor         Decimal  @db.Decimal(10, 2)
  taxa_gateway  Decimal? @db.Decimal(10, 2)
  valor_liquido Decimal? @db.Decimal(10, 2)

  provider String? @db.VarChar(50)

  external_id        String? @db.VarChar(191)
  external_reference String? @db.VarChar(191)

  idempotency_key String? @unique @db.VarChar(191)

  qr_code_text String? @db.Text
  payment_url  String? @db.VarChar(1000)

  aprovado_at  DateTime? @db.DateTime(0)
  expirado_at  DateTime? @db.DateTime(0)
  cancelado_at DateTime? @db.DateTime(0)

  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)

  vnd_pedido VndPedido @relation(fields: [vnd_pedido_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  fin_pagamento_status FinPagamentoStatus @relation(fields: [fin_pagamento_status_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  fin_pagamento_metodo FinPagamentoMetodo @relation(fields: [fin_pagamento_metodo_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([vnd_pedido_id])
  @@index([fin_pagamento_status_id])
  @@index([fin_pagamento_metodo_id])
  @@index([provider, external_id])
  @@index([created_at])
  @@map("fin_pagamento")
}

model SysAnalyticsEvento {
  id Int @id @default(autoincrement())

  sys_usuario_id Int?

  session_id String @db.VarChar(100)

  tipo String  @db.VarChar(40)
  nome String? @db.VarChar(100)

  rota          String  @db.VarChar(500)
  rota_anterior String? @db.VarChar(500)

  entidade_tipo String? @db.VarChar(50)
  entidade_id   Int?

  created_at DateTime @default(now()) @db.DateTime(0)

  sys_usuario SysUsuario? @relation(fields: [sys_usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([sys_usuario_id])
  @@index([session_id])
  @@index([tipo])
  @@index([nome])
  @@index([rota])
  @@index([entidade_tipo, entidade_id])
  @@index([created_at])
  @@map("sys_analytics_evento")
}
