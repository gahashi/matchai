# =========================
# Brava Pass - Environment Example
# =========================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="troque-por-uma-chave-grande-em-dev"
BETTER_AUTH_URL="http://localhost:3000"

# Database
DATABASE_URL="mysql://userBravaPass:SUA_SENHA@localhost:3306/brava_pass"

DB_HOST="localhost"
DB_PORT="3306"
DB_USER="userBravaPass"
DB_PASSWORD="SUA_SENHA"
DB_NAME="brava_pass"

# Email / SMTP
EMAIL_FROM="Brava Pass <noreply@bravapass.dev>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Storage - MinIO local / S3 compatible
STORAGE_DRIVER="s3"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="brava-pass-dev"
S3_ACCESS_KEY_ID="bravapass"
S3_SECRET_ACCESS_KEY="bravapass123"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL="http://127.0.0.1:9000/brava-pass-dev"